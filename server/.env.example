# Copy to server/.env  (never commit the real file)
# python server/hash_password.py   -> paste the line it prints
ADMIN_PASSWORD_HASH=
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# 1 on the live HTTPS site; set 0 only for testing over plain http://localhost
COOKIE_SECURE=1
# Public address, used for canonical links, link previews and the sitemap
SITE_URL=https://appelirhsa.co.za

# Fine-grained PAT: this one repo only, permission "Contents: Read and write"
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
